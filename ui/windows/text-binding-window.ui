<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0" />
  <object class="GtkWindow" id="text_binding_window">
    <property name="default-height">150</property>
    <property name="default-width">400</property>
    <property name="title">Text Binding</property>
    <property name="hide-on-close">True</property>
    <child>
      <object class="GtkBox" id="text_binding_box">
        <property name="margin-bottom">20</property>
        <property name="margin-end">20</property>
        <property name="margin-start">20</property>
        <property name="margin-top">20</property>
        <property name="orientation">vertical</property>
        <property name="spacing">10</property>
        <child>
          <object class="GtkEntry" id="text_binding_input">
            <property name="placeholder-text">Type something...</property>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="text_binding_label" />
        </child>
        <child>
          <object class="GtkButton" id="text_binding_button">
            <property name="label">Reset</property>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
